{
  "expo": {
    "name": "NEXA Mobile",
    "slug": "nexa-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "nexa",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nexa.mobile"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.nexa.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "f9eef7bd-8cee-4559-afc2-a42348f6f980"
      },
      "router": {}
    },
    "owner": "grezhuls-team"
  }
}
